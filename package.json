{
  "name": "magic",
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GSTJ/magic-modal.git"
  },
  "author": "Gabriel Taveira <gabrielstaveira@gmail.com> (https://github.com/GSTJ)",
  "license": "MIT",
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "bugs": {
    "url": "https://github.com/GSTJ/magic-modal/issues"
  },
  "homepage": "https://magic-modal.gabrieltaveira.dev/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "typecheck": "turbo run typecheck",
    "start": "turbo run start",
    "test": "pnpm run security:check && turbo run test",
    "changelog:check": "turbo run changelog:check --filter=magic-modal",
    "release:check": "turbo run release:check --filter=magic-modal",
    "build": "turbo run build",
    "release": "turbo run release --filter=magic-modal && pnpm --filter react-native-magic-modal run release",
    "docs": "pnpm --filter magic-modal build && pnpm --filter @magic-modal/docs build",
    "docs:dev": "pnpm --filter magic-modal build && pnpm --filter @magic-modal/docs dev",
    "registry:build": "shadcn build --output apps/docs/public/r && pnpm --filter @magic-modal/docs exec oxfmt public/r",
    "registry:check": "shadcn registry validate && pnpm registry:typecheck && pnpm registry:build",
    "registry:typecheck": "pnpm --filter magic-modal exec tsc --project ../../registry/tsconfig.json",
    "security:check": "pnpm audit",
    "doctor": "turbo run doctor"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "magic-codemods": "^1.1.0",
    "shadcn": "4.16.2",
    "turbo": "^2.5.4"
  }
}
