{
  "name": "@magic-modal/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && node scripts/write-legacy-redirects.mjs && node scripts/check-artifact.mjs",
    "dev": "next dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint --report-unused-disable-directives",
    "prebuild": "pnpm --workspace-root registry:build && node scripts/copy-og-image.mjs",
    "predev": "pnpm --workspace-root registry:build && node scripts/copy-og-image.mjs",
    "start": "serve out",
    "test": "node --test test/*.test.mjs",
    "typecheck": "pnpm --workspace-root registry:typecheck && fumadocs-mdx && next typegen && fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "fumadocs-core": "16.15.0",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-typescript": "5.3.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.0",
    "gsap": "3.15.0",
    "lucide-react": "^1.25.0",
    "magic-docs": "1.0.5",
    "magic-modal": "workspace:*",
    "next": "16.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "zbsearch": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "magic-oxfmt-config": "^1.2.0",
    "magic-oxlint-config": "^2.0.0",
    "magic-tsconfig": "^1.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "postcss": "^8.5.21",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  }
}
