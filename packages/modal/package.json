{
  "name": "magic-modal",
  "version": "10.2.1",
  "description": "A magic modal that can be used imperatively from anywhere! 🦄",
  "keywords": [
    "android",
    "expo",
    "ios",
    "modal",
    "nextjs",
    "react-native",
    "react-native-magic-modal",
    "react-native-web",
    "web"
  ],
  "homepage": "https://magic-modal.gabrieltaveira.dev/",
  "bugs": {
    "url": "https://github.com/GSTJ/magic-modal/issues"
  },
  "license": "MIT",
  "author": "Gabriel Taveira <gabrielstaveira@gmail.com> (https://github.com/GSTJ)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GSTJ/magic-modal.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.react-native.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "react-native": {
        "require": {
          "types": "./dist/index.react-native.d.cts",
          "default": "./dist/index.react-native.cjs"
        },
        "import": {
          "types": "./dist/index.react-native.d.ts",
          "default": "./dist/index.react-native.js"
        }
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bunchee && node tools/wrap-entrypoints.mjs && node tools/check-web-build.mjs && node tools/check-pack-consumer.mjs",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --report-unused-disable-directives --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "copy:readme": "shx cp ../../README.md ./README.md",
    "prepack": "pnpm run copy:readme",
    "test": "jest",
    "changelog:check": "node tools/changelog-check.mjs",
    "release:check": "node tools/burned-version-check.mjs && node tools/release-integrity.mjs self-test && node tools/release-artifacts.mjs self-test && node tools/release-integrity.mjs check",
    "release": "release-it --ci"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "bunchee": "^7.0.0",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "conventional-recommended-bump": "^12.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "jest-junit": "^17.0.0",
    "magic-oxfmt-config": "^1.2.0",
    "magic-oxlint-config": "^2.0.0",
    "magic-tsconfig": "^1.2.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "pod-install": "^1.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-reanimated": "4.2.3",
    "react-native-screens": "4.23.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.7.4",
    "react-test-renderer": "19.2.0",
    "release-it": "^21.0.0",
    "shx": "^0.4.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.81.0",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=4.1.0",
    "react-native-screens": ">=4.19.0",
    "react-native-worklets": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-screens": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  }
}
