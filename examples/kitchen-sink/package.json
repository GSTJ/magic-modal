{
  "name": "@magic/kitchen-sink",
  "version": "0.0.1",
  "private": true,
  "description": "Example app for magic-modal",
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start": "expo start",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --report-unused-disable-directives --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "doctor": "pnpm expo-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "expo": "^55.0.30",
    "expo-constants": "~55.0.17",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.17",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "magic-modal": "workspace:*",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-reanimated": "4.2.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "expo-doctor": "1.20.1",
    "magic-oxfmt-config": "^1.2.0",
    "magic-oxlint-config": "^1.2.0",
    "magic-tsconfig": "^1.2.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "magic-modal"
        ]
      }
    },
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-gesture-handler"
      ]
    }
  }
}
